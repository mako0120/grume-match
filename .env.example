# First-party グルメ日誌 PR intake (disabled unless spam check + DB are configured)
# Netlify-specific native form intake. Only enable AFTER turning on Netlify Form detection,
# redeploying and verifying the diary-pr-inquiry form is registered in the dashboard.
# This is separate from the Supabase-backed admin/booking workflow.
DIARY_NETLIFY_FORMS_ENABLED=false
DIARY_INQUIRIES_ENABLED=false
DIARY_SITE_MODE=false
DIARY_PUBLIC_INDEX_ENABLED=false
NEXT_PUBLIC_DIARY_TURNSTILE_SITE_KEY=
DIARY_TURNSTILE_SECRET_KEY=

# Verified by operator; no live Instagram API integration.
# Updating verified follower count recalculates rates for NEW inquiries only.
DIARY_VERIFIED_FOLLOWERS=5000
DIARY_FOLLOWERS_VERIFIED_AT=2026-10-16

# Owner's verified inbox for confirmed bookings; no emails sent without it.
DIARY_OPERATOR_NOTIFY_EMAIL=

# Shared Stripe account approved by owner for BASE/eBay + グルメ日誌.
# Invoice issuance remains disabled until the user explicitly configures
# verified server-side credentials, tax identity, webhook and test environment.
